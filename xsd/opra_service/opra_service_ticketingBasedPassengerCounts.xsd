    <xsd:element name="TicketingBasedPassengerCountRequest" type="TicketingBasedPassengerCountRequestStructure" substitutionGroup="OpraFunctionalRequest">
        <xsd:annotation>
            <xsd:documentation>A request element to get TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="TicketingBasedPassengerCountRequestStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the request element to get TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="OpraFunctionalRequestStructure">
                <xsd:group ref="TicketingBasedPassengerCountRequestGroup" />
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="TicketingBasedPassengerCountRequestGroup">
        <xsd:annotation>
            <xsd:documentation>References that extend filtering capabilites of requests for TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:group ref="TicketingScopeGroup" />
        </xsd:sequence>
    </xsd:group>
    <xsd:element name="TicketingBasedPassengerCountDiscoveryRequest" type="TicketingBasedPassengerCountDiscoveryRequestStructure" substitutionGroup="OpraDiscoveryRequest">
        <xsd:annotation>
            <xsd:documentation>A discovery request element to get TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="TicketingBasedPassengerCountDiscoveryRequestStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the discovery request element to get TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="OpraDiscoveryRequestStructure">
                <xsd:group ref="TicketingBasedPassengerCountDiscoveryRequestGroup" />
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="TicketingBasedPassengerCountDiscoveryRequestGroup">
        <xsd:annotation>
            <xsd:documentation>References that extend filtering capabilities of requests for TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:group ref="TicketingScopeGroup" />
        </xsd:sequence>
    </xsd:group>
    <xsd:element name="TicketingBasedPassengerCountDiscoveryDelivery" type="TicketingBasedPassengerCountDiscoveryDeliveryStructure" substitutionGroup="OpraDiscoveryDelivery">
        <xsd:annotation>
            <xsd:documentation>A discovery delivery element to get TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="TicketingBasedPassengerCountDiscoveryDeliveryStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the discovery delivery element to get TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="OpraDiscoveryDeliveryStructure">
                <xsd:group ref="TicketingBasedPassengerCountDiscoveryDeliveryGroup" />
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="TicketingBasedPassengerCountDiscoveryDeliveryGroup">
        <xsd:annotation>
            <xsd:documentation>References that extend filtering capabilities of discovery delivery for TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:group ref="TicketingScopeGroup" />
            <xsd:element name="OperatingDays" type="netex:operatingDays_RelStructure" />
        </xsd:sequence>
    </xsd:group>
