	<!-- ======================================================================= -->
	<xsd:simpleType name="PtScopeIdType">
		<xsd:annotation>
			<xsd:documentation>Identifier of a PT SCOPE.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="netex:ObjectIdType"/>
	</xsd:simpleType>
	<!-- ======================================================================= -->
	<xsd:group name="PtScopeGroup">
		<xsd:annotation>
			<xsd:documentation>PT SCOPE structure.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element ref="netex:AuthorityRef" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Authority organisation scope (optional).</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element ref="netex:OperatorRef" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Operator organisation scope (optional).</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element ref="netex:SiteRef" minOccurs="0"/>
			<xsd:element ref="netex:NetworkRef" minOccurs="0"/>
			<xsd:element ref="netex:VehicleMode" minOccurs="0"/>
			<xsd:element ref="netex:LineRef" minOccurs="0"/>
			<xsd:element ref="netex:JourneyPatternRef" minOccurs="0"/>
			<xsd:element ref="netex:ScheduledStopPointRef" minOccurs="0"/>
			<xsd:element ref="netex:VehicleJourneyRef" minOccurs="0"/>
			<xsd:element ref="netex:DatedVehicleJourneyRef" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
	<xsd:group name="CalendarAwarePtScopeGroup">
		<xsd:sequence>
			<xsd:group ref="PtScopeGroup"/>
			<xsd:element ref="netex:DayTypeRef" minOccurs="0"/>
			<xsd:element ref="netex:OperatingDayRef" minOccurs="0"/>
			<xsd:element ref="netex:TimebandRef" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
	<xsd:simpleType name="RollingStockTypeEnumeration">
		<xsd:restriction base="xsd:NMTOKEN">
			<xsd:enumeration value="all"/>
			<xsd:enumeration value="selfPropelled"/>
			<xsd:enumeration value="tractive"/>
			<xsd:enumeration value="trailing"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="RollingStockType" type="RollingStockTypeEnumeration" default="all"/>
	<xsd:group name="FleetScopeGroup">
		<xsd:sequence>
			<xsd:element ref="netex:GarageRef" minOccurs="0"/>
			<xsd:element ref="netex:VehicleTypeRef" minOccurs="0"/>
			<xsd:element ref="netex:VehicleRef" minOccurs="0"/>
			<xsd:element ref="RollingStockType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
</xsd:schema>
