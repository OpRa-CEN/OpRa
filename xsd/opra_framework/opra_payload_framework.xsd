<xsd:schema xmlns="https://transmodel-cen.eu/opra/1.0" xmlns:netex="http://www.netex.org.uk/netex" xmlns:xsd="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" id="opra_payload_framework" targetNamespace="https://transmodel-cen.eu/opra/1.0" version="1.0">
	<xsd:import schemaLocation="../opra_imports/opra_netex_imports.xsd" namespace="http://www.netex.org.uk/netex"/>
	<xsd:include schemaLocation="opra_frames/opra_plannedServiceFrame_version.xsd"/>
	<xsd:include schemaLocation="opra_frames/opra_actualServiceFrame_version.xsd"/>
	<xsd:include schemaLocation="opra_frames/opra_indicatorFrame_version.xsd"/>
	<xsd:include schemaLocation="opra_frames/opra_contextualIndicatorFrame_version.xsd"/>
	<!--TODO: NEEDS A PROPER HEADER	-->
	<xsd:complexType name="dataObjects_RelStructure">
		<xsd:annotation>
			<xsd:documentation>Type for the possible data objects within an OpRa payload.</xsd:documentation>
		</xsd:annotation>
		<xsd:choice maxOccurs="unbounded">
			<xsd:element ref="netex:CompositeFrame" minOccurs="0"/>
			<xsd:element ref="PlannedServiceFrame" minOccurs="0"/>
			<xsd:element ref="ActualServiceFrame" minOccurs="0"/>
			<xsd:element ref="IndicatorFrame" minOccurs="0"/>
			<xsd:element ref="ContextualIndicatorFrame" minOccurs="0"/>
		</xsd:choice>
	</xsd:complexType>
	<xsd:group name="PayloadGroup">
		<xsd:annotation>
			<xsd:documentation>OpRa payload elements.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="dataObjects" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>OpRa Entities in the data exchange.</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:complexContent>
						<xsd:extension base="dataObjects_RelStructure"/>
					</xsd:complexContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:group>
</xsd:schema>
