<xsd:schema xmlns:siri="http://www.siri.org.uk/siri" xmlns:core="http://www.govtalk.gov.uk/core" xmlns="https://transmodel-cen.eu/opra/1.0" xmlns:netex="http://www.netex.org.uk/netex" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:opra="https://transmodel-cen.eu/opra/1.0" attributeFormDefault="unqualified" elementFormDefault="qualified" id="opra_publication" targetNamespace="https://transmodel-cen.eu/opra/1.0" version="1.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <!-- ===SIRI system IDs for  request =========================================================== -->
    <xsd:import schemaLocation="opra_imports/opra_siri_imports.xsd" namespace="http://www.siri.org.uk/siri" />
    <!-- ===Regular netex============================================================== -->
    <xsd:import schemaLocation="opra_imports/opra_netex_imports.xsd" namespace="http://www.netex.org.uk/netex" />
    <!-- ===Includes (OpRa)============================================================== -->
    <xsd:include schemaLocation="opra_framework/opra_payload_framework.xsd" />
    <!-- === Documentation ======================================= -->
    <xsd:annotation>
        <xsd:appinfo>
			<Metadata>
				<Aggregation>main schema</Aggregation>
				<Audience>e-service developers</Audience>
				<Coverage>Europe</Coverage>
				<Creator>First Drafted for version 1.0 CEN TC278 WG3 SG10 - OpRa -  Editor CEN Opra Project Team</Creator>
				<Date>
					<Created>2024-11-29</Created>
				</Date>
				<Description>
					<p>OpRa - Operational Raw Data</p>
				</Description>
				<Format>
					<MediaType>text/xml</MediaType>
					<Syntax>http://www.w3.org/2001/XMLSchema</Syntax>
					<Description>XML schema, W3C Recommendation 2001</Description>
				</Format>
				<Identifier>{https://transmodel-cen.eu/opra/1.0/xsd/opra_request.xsd</Identifier>
				<Language>[ISO 639-2/B] ENG</Language>
				<Rights>Unclassified
				</Rights>
				<Source>
					<ul>
						<li>Created for OpRa</li>
					</ul>
				</Source>
				<Status>Initial Version</Status>
				<Subject>
					<Category>Arts, recreation and travel, Tourism, Travel (tourism), Transport,
                        Air transport, Airports,
                        Ports and maritime transport, Ferries (marine),
                        Public transport, Bus services, Coach services, Bus stops and stations,
                        Rail transport, Railway stations and track, Train services, Underground trains,
                        Business and industry, Transport, Air transport , Ports and maritime transport, Public transport,
                        Rail transport, Roads and Road transport
                    </Category>
					<Project>CEN TC278 WG3 SG10.</Project>
				</Subject>
				<Title>Opra Operational Raw Data Exchange</Title>
				<Type>Standard</Type>
			</Metadata>
		</xsd:appinfo>
        <xsd:documentation>OpRa REQUEST/RESPONSE DELIVERY SCHEMA</xsd:documentation>
    </xsd:annotation>
    <!-- ======================================================================= -->
    <xsd:group name="ServiceRequestContextGroup">
        <xsd:annotation>
            <xsd:documentation>Generic context for all request messages.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="DataFrameRef" type="siri:DataFrameRefStructure" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Identifier of the set of data being used by an information system, which allows a comparison to be made with the versions of data being used by overlapping systems. </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="Extension" type="xsd:anyType" minOccurs="0" />
        </xsd:sequence>
    </xsd:group>
    <xsd:group name="ServiceResponseContextGroup">
        <xsd:annotation>
            <xsd:documentation>Generic context for all response messages.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="DataFrameRef" type="siri:DataFrameRefStructure" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Identifier of the set of data being used by an information system, which allows a comparison to be made with the versions of data being used by overlapping systems. </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="ErrorCondition" type="OpRaErrorStructure" minOccurs="0" maxOccurs="unbounded">
                <xsd:annotation>
                    <xsd:documentation>OpRa generic problem for the whole delivery.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:group>
    <xsd:annotation>
        <xsd:documentation>========================================== Request definitions ==========================================</xsd:documentation>
    </xsd:annotation>
    <xsd:element name="OpRaRequests" type="OpRaBulkRequestsStructure">
        <xsd:annotation>
            <xsd:documentation>Main collection element for an OpRa (bulk) request.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="OpRaBulkRequestsStructure">
        <xsd:complexContent>
            <xsd:extension base="OpRaRequests_RelStructure">
                <xsd:sequence>
                    <xsd:element name="frames" type="netex:frames_RelStructure" minOccurs="0" />
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:complexType name="AbstractOpRaServiceRequestStructure">
        <xsd:annotation>
            <xsd:documentation>Basic request structure common for all OpRa service requests.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="siri:AbstractFunctionalServiceRequestStructure">
                <xsd:group ref="ServiceRequestContextGroup" />
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="OpRaRequest" type="OpRaRequestStructure" substitutionGroup="siri:AbstractFunctionalServiceRequest" abstract="true">
        <xsd:annotation>
            <xsd:documentation>Generic abstract OpRa request element. Substitute this element with topic-specific request elements.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="OpRaRequestStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the generic abstract OpRa request.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="AbstractOpRaServiceRequestStructure">
                <xsd:sequence>
                    <xsd:element ref="siri:Extensions" minOccurs="0" />
                    <xsd:group ref="OpRaRequestGroup" />
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:complexType name="OpRaRequests_RelStructure">
        <xsd:annotation>
            <xsd:documentation>Type for a collection of OpRaRequests.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element ref="OpRaRequest" maxOccurs="unbounded" />
        </xsd:sequence>
    </xsd:complexType>
    <xsd:element name="OpRaDelivery" type="OpRaDeliveryStructure" substitutionGroup="siri:AbstractFunctionalServiceDelivery">
        <xsd:annotation>
            <xsd:documentation>Response element for OpRaRequests. Contains a generic OpRa payload.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="OpRaDeliveryStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the generic OpRa response element.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="siri:AbstractServiceDeliveryStructure">
                <xsd:sequence>
                    <xsd:element ref="siri:Extensions" minOccurs="0" />
                    <xsd:element ref="OpRaRequest" minOccurs="0" />
                    <xsd:group ref="PayloadGroup" />
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="OpRaRequestGroup">
        <xsd:annotation>
            <xsd:documentation>Generic scope and preparedness state structures to be used in OpRaRequests.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="Description" type="netex:MultilingualString" minOccurs="0" />
            <xsd:element name="frames" type="netex:frames_RelStructure" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Collection of FRAMEs to form context(s) within a request.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element ref="PreparednessLevel" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Requested preparedness level for the delivered elements.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:group ref="PtScopeGroup" />
        </xsd:sequence>
    </xsd:group>
    <xsd:element name="LateDatedVehicleJourneysRequest" type="LateDatedVehicleJourneysRequestStructure" substitutionGroup="OpRaRequest">
        <xsd:annotation>
            <xsd:documentation>A request element to get LATE DATED VEHICLE JOURNEYs.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="LateDatedVehicleJourneysRequestStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the request element to get LATE DATED VEHICLE JOURNEYs.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="OpRaRequestStructure">
                <xsd:group ref="LateDatedVehicleJourneysRequestGroup" />
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="LateDatedVehicleJourneysRequestGroup">
        <xsd:annotation>
            <xsd:documentation>References that extend filtering capabilites of requests for LATE DATED VEHICLE JOURNEYs.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:group ref="LateDatedVehicleJourneyScopeGroup" />
        </xsd:sequence>
    </xsd:group>
    <xsd:element name="CancelledDatedVehicleJourneysRequest" type="CancelledDatedVehicleJourneysRequestStructure" substitutionGroup="OpRaRequest">
        <xsd:annotation>
            <xsd:documentation>A request element to get CANCELLED DATED VEHICLE JOURNEYs.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="CancelledDatedVehicleJourneysRequestStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the request element to get LATE DATED VEHICLE JOURNEYs.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="OpRaRequestStructure">
                <xsd:group ref="CancelledDatedVehicleJourneysRequestGroup" />
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="CancelledDatedVehicleJourneysRequestGroup">
        <xsd:annotation>
            <xsd:documentation>References that extend filtering capabilites of requests for CANCELLED DATED VEHICLE JOURNEYs.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:group ref="CancelledDatedVehicleJourneyScopeGroup" />
        </xsd:sequence>
    </xsd:group>
    <xsd:element name="TicketingBasedPassengerCountRequest" type="TicketingBasedPassengerCountRequestStructure" substitutionGroup="OpRaRequest">
        <xsd:annotation>
            <xsd:documentation>A request element to get TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="TicketingBasedPassengerCountRequestStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the request element to get TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="OpRaRequestStructure">
                <xsd:group ref="TicketingBasedPassengerCountRequestGroup" />
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="TicketingBasedPassengerCountRequestGroup">
        <xsd:annotation>
            <xsd:documentation>References that extend filtering capabilites of requests for TICKETING BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:group ref="TicketingScopeGroup" />
        </xsd:sequence>
    </xsd:group>
    <xsd:element name="OnboardDeviceBasedPassengerCountRequest" type="OnboardDeviceBasedPassengerCountRequestStructure" substitutionGroup="OpRaRequest">
        <xsd:annotation>
            <xsd:documentation>A request element to get ONBOARD DEVICE BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="OnboardDeviceBasedPassengerCountRequestStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the request element to get ONBOARD DEVICE BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="OpRaRequestStructure">
                <xsd:group ref="OnboardDeviceBasedPassengerCountRequestGroup" />
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="OnboardDeviceBasedPassengerCountRequestGroup">
        <xsd:annotation>
            <xsd:documentation>References that extend filtering capabilites of requests for ONBOARD DEVICE BASED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:group ref="OnboardDeviceScopeGroup" />
        </xsd:sequence>
    </xsd:group>
    <xsd:element name="ExternalPassengerCountRequest" type="ExternalPassengerCountRequestStructure" substitutionGroup="OpRaRequest">
        <xsd:annotation>
            <xsd:documentation>A request element to get EXTERNAL PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="ExternalPassengerCountRequestStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the request element to get EXTERNAL PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="OpRaRequestStructure" />
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="ExternalPassengerCountRequestGroup">
        <xsd:annotation>
            <xsd:documentation>References that extend filtering capabilites of requests for EXTERNAL PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence />
    </xsd:group>
    <xsd:element name="ExpectedPassengerCountRequest" type="ExpectedPassengerCountRequestStructure" substitutionGroup="OpRaRequest">
        <xsd:annotation>
            <xsd:documentation>A request element to get EXPECTED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="ExpectedPassengerCountRequestStructure">
        <xsd:annotation>
            <xsd:documentation>Type for the request element to get EXPECTED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="OpRaRequestStructure" />
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="ExpectedPassengerCountRequestGroup">
        <xsd:annotation>
            <xsd:documentation>References that extend filtering capabilites of requests for EXPECTED PASSENGER COUNTs.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence />
    </xsd:group>
    <xsd:element name="OpRaError" type="OpRaErrorStructure" substitutionGroup="siri:OtherError">
        <xsd:annotation>
            <xsd:documentation>Error: All OpRa related errors.</xsd:documentation>
        </xsd:annotation>
    </xsd:element>
    <xsd:complexType name="OpRaErrorStructure">
        <xsd:annotation>
            <xsd:documentation>Type for Error: OpRa Error.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="siri:OtherErrorStructure">
                <xsd:sequence>
                    <xsd:element ref="ErrorType" />
                    <xsd:group minOccurs="0" ref="ProblemDetailGroup">
                        <xsd:annotation>
                            <xsd:documentation>ProblemDetailGroup</xsd:documentation>
                        </xsd:annotation>
                    </xsd:group>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="ErrorType" type="xsd:string" abstract="true" />
    <xsd:group name="ProblemDetailGroup">
        <xsd:annotation>
            <xsd:documentation>Detailed description of the problem.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="Details" type="netex:MultilingualString" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Explanation of the problem.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="LogData" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Additional log data.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:group>
</xsd:schema>