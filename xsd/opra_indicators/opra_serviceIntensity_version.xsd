<xsd:schema xmlns:netex="http://www.netex.org.uk/netex" xmlns="https://transmodel-cen.eu/opra/1.0" xmlns:siri="http://www.siri.org.uk/siri" xmlns:xsd="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" id="opra_serviceIntensity_version" targetNamespace="https://transmodel-cen.eu/opra/1.0" version="1.0">
	<!-- SIRI Imports-->
	<xsd:import schemaLocation="../opra_imports/opra_siri_imports.xsd" namespace="http://www.siri.org.uk/siri"/>
	<!-- NeTEX Imports-->
	<xsd:import schemaLocation="../opra_imports/opra_netex_facade.xsd" namespace="http://www.netex.org.uk/netex"/>
	<!-- OpRa includes-->
	<xsd:include schemaLocation="../opra_framework/opra_frames/opra_indicatorFrame_version.xsd"/>
	<xsd:include schemaLocation="../opra_framework/opra_genericFramework/opra_GeneralLogEntry_version.xsd"/>
	<xsd:include schemaLocation="../opra_framework/opra_reusableComponents/opra_filtering_support.xsd"/>
	<xsd:include schemaLocation="../opra_framework/opra_reusableComponents/opra_vehicleOccupancy_version.xsd"/>
	<xsd:include schemaLocation="../opra_indicators/opra_capacity_version.xsd"/>
	<xsd:annotation>
		<xsd:appinfo>
			<Metadata xmlns="https://transmodel-cen.eu/opra/1.0">
				<Aggregation>main schema</Aggregation>
				<Audience>e-service developers</Audience>
