			<xsd:element ref="netex:FareProductRef" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
	<!-- ======================================================================= -->
	<xsd:element name="TicketingBasedPassengerCount" substitutionGroup="AbstractIndicator">
		<xsd:annotation>
			<xsd:documentation>Implementation of LOGGABLE OBJECT designed for recording TICKETING BASED PASSENGER COUNT information.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:restriction base="TicketingBasedPassengerCount_VersionStructure">
					<xsd:sequence>
						<xsd:sequence>
							<xsd:group minOccurs="0" ref="netex:EntityInVersionGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="netex:DataManagedObjectGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="LoggableObjectGroup"/>
						</xsd:sequence>
						<xsd:sequence>
							<xsd:group ref="TicketingBasedPassengerCountGroup"/>
						</xsd:sequence>
					</xsd:sequence>
					<xsd:attribute name="id" type="TicketingBasedPassengerCountIdType"/>
				</xsd:restriction>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="TicketingBasedPassengerCount_VersionStructure">
		<xsd:annotation>
			<xsd:documentation>Type for a LOGGABLE OBJECT designed for recording DATED VEHICLE JOURNEY information.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="Indicator_VersionStructure">
				<xsd:sequence>
					<xsd:group ref="TicketingBasedPassengerCountGroup"/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="TicketingBasedPassengerCountGroup">
		<xsd:annotation>
			<xsd:documentation>Static (same in each state) elements for a TicketingBasedPassengerCount (as a LOGGABLE OBJECT)</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:group ref="CalendarAwarePtScopeGroup"/>
			<xsd:group ref="FleetScopeGroup"/>
			<xsd:group ref="TicketingScopeGroup"/>
			<xsd:group ref="siri:OccupancyScopeFilterGroup"/>
			<xsd:group ref="VehicleLoadEntryGroup"/>
			<xsd:element name="validationEntryRefs" type="ValidationEntryRefs_RelStructure" minOccurs="0"/>
			<xsd:element name="history" type="AggregatedTicketingBasedPassengerCounts_RelStructure" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
	<xsd:complexType name="TicketingBasedPassengerCounts_RelStructure">
		<xsd:annotation>
			<xsd:documentation>A collection of one or more TicketingBasedPassengerCounts.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element ref="TicketingBasedPassengerCount" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>LOGGABLE OBJECT designed for recording TICKETING BASED PASSENGER COUNT information.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="AggregatedTicketingBasedPassengerCount" type="AggregatedTicketingBasedPassengerCount_Structure" substitutionGroup="AbstractIndicatorLogEntry"/>
	<xsd:complexType name="AggregatedTicketingBasedPassengerCount_Structure">
		<xsd:complexContent>
			<xsd:extension base="IndicatorLogEntry_VersionStructure">
				<xsd:group ref="AggregatedTicketingBasedPassengerCountGroup"/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="AggregatedTicketingBasedPassengerCountGroup">
		<xsd:annotation>
			<xsd:documentation>Dynamic (may change in each state) elements for an AggregatedTicketingBasedPassengerCount (as a LOG ENTRY)</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:group ref="siri:OccupancyScopeFilterGroup"/>
			<xsd:group ref="VehicleLoadEntryGroup"/>
			<xsd:element name="validationEntryRefs" type="ValidationEntryRefs_RelStructure" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
	<xsd:complexType name="AggregatedTicketingBasedPassengerCounts_RelStructure">
		<xsd:sequence>
			<xsd:element ref="AggregatedTicketingBasedPassengerCount" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
