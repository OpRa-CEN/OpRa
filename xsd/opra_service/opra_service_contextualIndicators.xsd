	<xsd:element name="ContextualIndicatorRequest" type="CtxIndicatorRequestStructure" substitutionGroup="OpraFunctionalRequest">
		<xsd:annotation>
			<xsd:documentation>A request element to get CONTEXTUAL INDICATORs.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="CtxIndicatorRequestStructure">
		<xsd:annotation>
			<xsd:documentation>Type for the request element to get CONTEXTUAL INDICATORs.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="OpraFunctionalRequestStructure">
				<xsd:group ref="CtxIndicatorRequestGroup"/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="CtxIndicatorRequestGroup">
		<xsd:annotation>
			<xsd:documentation>References that extend filtering capabilities of requests for CONTEXTUAL INDICATORs.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:group ref="IndicatorContextRequestGroup"/>
			<xsd:element name="CtxIndicatorIdentifierRef" type="xsd:normalizedString"/>
		</xsd:sequence>
	</xsd:group>
	<xsd:group name="IndicatorContextRequestGroup">
		<xsd:sequence>
			<xsd:element name="ContextIdentifierRef" type="xsd:normalizedString"/>
			<xsd:element name="MinimumContextVersion" type="netex:VersionIdType" minOccurs="0"/>
			<xsd:element name="ExactContextVersion" type="netex:VersionIdType" minOccurs="0"/>
			<xsd:element name="ContextKeyList" type="netex:KeyListStructure" minOccurs="0"/>
		</xsd:sequence>
	</xsd:group>
	<xsd:element name="ContextualIndicatorDiscoveryRequest" type="CtxIndicatorDiscoveryRequestStructure" substitutionGroup="OpraDiscoveryRequest">
		<xsd:annotation>
			<xsd:documentation>A request element to get CONTEXTUAL INDICATORs.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="CtxIndicatorDiscoveryRequestStructure">
		<xsd:annotation>
			<xsd:documentation>Type for the request element to get CONTEXTUAL INDICATORs.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="OpraDiscoveryRequestStructure">
				<xsd:group ref="CtxIndicatorRequestGroup"/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:element name="ContextualIndicatorDiscoveryDelivery" type="CtxIndicatorDiscoveryDeliveryStructure" substitutionGroup="OpraDiscoveryDelivery">
		<xsd:annotation>
			<xsd:documentation>A request element to get CONTEXTUAL INDICATORs.</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="CtxIndicatorDiscoveryDeliveryStructure">
		<xsd:annotation>
			<xsd:documentation>Type for the request element to get CONTEXTUAL INDICATORs.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="OpraDiscoveryDeliveryStructure">
				<xsd:group ref="CtxIndicatorDiscoveryDeliveryGroup"/>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:group name="CtxIndicatorDiscoveryDeliveryGroup">
		<xsd:annotation>
			<xsd:documentation>Specific data content of a discovery delivery for CONTEXTUAL INDICATORs.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OperatingDays" type="netex:operatingDays_RelStructure">
				<xsd:annotation>
					<xsd:documentation>Collection of OPERATING DAYS that have data within the discovery request's scope.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:group>
</xsd:schema>
